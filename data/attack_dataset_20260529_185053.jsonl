"{\n  \"scenario_id\": \"ATK-2023-001\",\n  \"environment_type\": \"Enterprise Network\",\n  \"difficulty\": \"Medium\",\n  \"attack_type\": \"Ransomware\",\n  \"realism_score\": 8.5,\n  \"narrative\": \"An employee in the finance department receives a phishing email that leads to a ransomware attack, encrypting sensitive data and demanding a ransom for decryption keys.\",\n  \"attack_stages\": [\n    {\n      \"stage_name\": \"Initial Access\",\n      \"technique_id\": \"T1566\",\n      \"description\": \"An employee receives a phishing email that contains a malicious attachment disguised as an invoice. The employee opens the attachment, executing the malware.\"\n    },\n    {\n      \"stage_name\": \"Execution\",\n      \"technique_id\": \"T1203\",\n      \"description\": \"The malware exploits a vulnerability in the employee's application, executing shell commands to establish a foothold in the system.\"\n    },\n    {\n      \"stage_name\": \"Persistence\",\n      \"technique_id\": \"T1547\",\n      \"description\": \"The attacker creates a new scheduled task to ensure the malware runs on system reboot, maintaining access to the compromised system.\"\n    },\n    {\n      \"stage_name\": \"Privilege Escalation\",\n      \"technique_id\": \"T1068\",\n      \"description\": \"The ransomware exploits a known vulnerability to gain administrative privileges, allowing it to spread across the network.\"\n    },\n    {\n      \"stage_name\": \"Data Encryption\",\n      \"technique_id\": \"T1486\",\n      \"description\": \"The ransomware begins encrypting files on the infected machine and shared network drives, targeting critical business data.\"\n    },\n    {\n      \"stage_name\": \"Demand for Ransom\",\n      \"technique_id\": \"T1537\",\n      \"description\": \"A ransom note is displayed on the infected machines, informing users of the encryption and demanding payment in cryptocurrency for decryption keys.\"\n    }\n  ],\n  \"mitre_attack_mapping\": [\n    \"T1566\",\n    \"T1203\",\n    \"T1547\",\n    \"T1068\",\n    \"T1486\",\n    \"T1537\"\n  ],\n  \"attack_graph\": {\n    \"nodes\": [\n      \"Phishing Email\",\n      \"Malicious Attachment\",\n      \"Exploit Application Vulnerability\",\n      \"Scheduled Task\",\n      \"Gain Admin Privileges\",\n      \"Encrypt Files\",\n      \"Ransom Note\"\n    ],\n    \"edges\": [\n      [\"Phishing Email\", \"Malicious Attachment\"],\n      [\"Malicious Attachment\", \"Exploit Application Vulnerability\"],\n      [\"Exploit Application Vulnerability\", \"Scheduled Task\"],\n      [\"Scheduled Task\", \"Gain Admin Privileges\"],\n      [\"Gain Admin Privileges\", \"Encrypt Files\"],\n      [\"Encrypt Files\", \"Ransom Note\"]\n    ]\n  }\n}"
